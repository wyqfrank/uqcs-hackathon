NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000
FITTED_INFERENCE_API_URL=http://localhost:8000

# Copy to .env.local.

# --- TURN relay (Cloudflare Realtime) ------------------------------------
# Preferred. Cloudflare issues short-lived credentials, so these stay on the
# SERVER and are never exposed to the browser: /api/turn-credentials mints an
# expiring username/credential pair per page load.
#
# Dashboard -> Realtime -> TURN -> Create TURN key.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# --- TURN opt-out ---------------------------------------------------------
# Skips relay allocation entirely. Useful when both laptops are on a network
# you already know works, so local testing does not spend relay quota. Direct
# connections behave normally; only the fallback is gone. Never set this for a
# build you intend to demo on an unfamiliar network.
# NEXT_PUBLIC_DISABLE_TURN=1

# --- TURN relay (static credentials) -------------------------------------
# Fallback for a self-hosted coturn or any provider issuing long-lived
# credentials. Used only when Cloudflare is not configured. These ARE exposed
# in the browser bundle, so anyone can spend the relay quota.
#
# Comma-separated. Include a TCP/443 entry so the relay survives networks that
# block UDP entirely.
# NEXT_PUBLIC_TURN_URLS=turn:your-host:3478,turn:your-host:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Extra development origins, separated by commas. Common tunnel providers are
# already allowed by apps/web/next.config.ts.
# DEV_ORIGINS=192.168.1.20

# --- HTTPS for LAN testing -----------------------------------------------
# Needed so a second laptop can reach getUserMedia over the LAN.
# SSL_KEY_PATH=./certificates/192.168.1.20-key.pem
# SSL_CERT_PATH=./certificates/192.168.1.20.pem
