NEXT_PUBLIC_INFERENCE_API_URL=http://localhost:8000

# Preferred TURN relay: short-lived credentials minted server-side through
# Cloudflare Realtime. These secrets are never exposed to the browser.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Optional static TURN fallback. These values are included in the browser
# bundle, so use them only with a relay account intended for public clients.
# Include TCP/443 for networks that block UDP.
# NEXT_PUBLIC_TURN_URLS=turn:your-host:3478,turn:your-host:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Disable TURN only on a network you already know supports direct WebRTC.
# NEXT_PUBLIC_DISABLE_TURN=1

# Extra development origins, separated by commas. Common tunnel providers are
# already allowed by apps/web/next.config.ts.
# DEV_ORIGINS=192.168.1.20

# Trusted HTTPS certificate for LAN testing.
# SSL_KEY_PATH=./certificates/192.168.1.20-key.pem
# SSL_CERT_PATH=./certificates/192.168.1.20.pem
