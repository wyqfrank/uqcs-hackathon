{
  "name": "fitted",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "setup": "npm install && node scripts/setup-python.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @fitted/web",
    "dev:api": "node scripts/python.mjs -m uvicorn fitted_inference.main:app --app-dir services/inference/src --reload --port 8000",
    "build": "npm run build --workspace @fitted/web",
    "start": "npm run start --workspace @fitted/web",
    "test": "npm run test:web && npm run test:signaling && npm run test:api",
    "test:web": "npm run test:unit --workspace @fitted/web",
    "test:signaling": "npm run test:signaling --workspace @fitted/web",
    "test:api": "node scripts/python.mjs -m pytest services/inference",
    "typecheck": "npm run typecheck --workspace @fitted/web",
    "lint:api": "node scripts/python.mjs -m ruff check services/inference",
    "check": "npm run typecheck && npm run test && npm run lint:api && npm run build"
  }
}
