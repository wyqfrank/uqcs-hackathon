FITTED_ENV=development
FITTED_CORS_ORIGINS=http://localhost:3000
FITTED_MAX_IMAGE_BYTES=5242880
FITTED_SCORING_BACKEND=vlm_fallback
FITTED_VLM_MODEL=gemini-3.6-flash
FITTED_VLM_MEDIA_RESOLUTION=high
FITTED_VLM_TIMEOUT_SECONDS=12
FITTED_VLM_PROMPT_VERSION=v1
# GEMINI_API_KEY=replace-me
# FITTED_MODEL_PATH=./models/fitted-baseline.pt
FITTED_GARMENT_MODEL_ID=IDEA-Research/grounding-dino-tiny
FITTED_GARMENT_BOX_THRESHOLD=0.35
FITTED_GARMENT_TEXT_THRESHOLD=0.25
# FITTED_GARMENT_DEVICE=cuda
# FITTED_GARMENT_LOCAL_FILES_ONLY=true
